# MongoDB Atlas connection string — lấy từ Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority

# Đổi thành chuỗi ngẫu nhiên dài (VD: openssl rand -hex 32) trước khi triển khai thật
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

FRONTEND_URL=http://localhost:3000
PORT=3001

# Chỉ cần nếu gặp lỗi "querySrv ECONNREFUSED" khi kết nối mongodb+srv:// —
# một số router/DNS nội bộ không trả lời được truy vấn SRV.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Cloudinary — Dashboard (cloud name) + Settings > Access Keys (api key/secret).
# Dùng để backend ký (sign) yêu cầu upload file học sinh nộp bài.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
